#!/usr/bin/env python3
"""
gos-rbac-audit — RBAC validator pra SKILL.md.

Para cada SKILL.md em .claude/skills/*/, checa se as tools que o body do
SKILL.md INVOCA (Read, Write, Edit, Bash, Glob, Grep, Agent, WebSearch,
WebFetch, TaskCreate, TaskUpdate) estão declaradas no campo `allowed-tools`
do frontmatter.

Tool detection (regex no body do SKILL.md):
    Read         → uso de "Read tool"/"read file"/Read invocations
    Write        → "Write" capability mentioned + actual write semantics
    Edit         → "Edit tool"
    Bash         → bash code blocks (```bash)
    Agent        → mentions "Agent tool" / subagent invocation
    WebSearch    → research/pesquisa via web
    WebFetch     → URL fetch
    Glob/Grep    → pattern matching

Detecta:
    - DECLARED but NOT USED  (allowed-tools: includes X but body doesn't show X)
    - USED but NOT DECLARED  (body invokes X but allowed-tools omits X) ← bug

Usage:
    gos-rbac-audit [--repo-root .] [--filter skill-name] [--strict]

Exit codes:
    0 — nenhum issue
    1 — issues encontrados (USED but NOT DECLARED — risco RBAC)
    2 — repo-root inválido
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path
from typing import Any


# Patterns que indicam invocação de uma tool no body do SKILL.md
TOOL_DETECTORS = {
    "Read": [
        r"\bRead tool\b",
        r"`Read\(",
        r"Read\(file_path",
        r"ler arquivo",
        r"read file",
    ],
    "Write": [
        r"\bWrite tool\b",
        r"`Write\(",
        r"escrever arquivo",
        r"create file",
    ],
    "Edit": [
        r"\bEdit tool\b",
        r"`Edit\(",
        r"editar arquivo",
        r"sed -i",  # in-place edit via Bash
    ],
    "Bash": [
        r"```bash\b",
        r"```sh\b",
        r"\bBash tool\b",
        r"`Bash\(",
        r"bash[\s\S]{0,40}execute",
    ],
    "Glob": [
        r"\bGlob tool\b",
        r"`Glob\(",
        r"\bglob\(",
        r"glob pattern",
    ],
    "Grep": [
        r"\bGrep tool\b",
        r"`Grep\(",
        r"\bgrep -",
    ],
    "Agent": [
        r"\bAgent tool\b",
        r"\bAgent\.invoke\(",
        r"subagent",
        r"invoca.*employee",
        r"chama.*subagent",
    ],
    "WebSearch": [
        r"\bWebSearch\b",
        r"`WebSearch\(",
        r"pesquisar via web",
        r"buscar.*internet",
    ],
    "WebFetch": [
        r"\bWebFetch\b",
        r"`WebFetch\(",
    ],
    "TaskCreate": [
        r"\bTaskCreate\b",
        r"`TaskCreate\(",
    ],
    "TaskUpdate": [
        r"\bTaskUpdate\b",
        r"`TaskUpdate\(",
    ],
}


def split_frontmatter_body(text: str) -> tuple[str, str]:
    """Returns (frontmatter_yaml, body)."""
    match = re.match(r"^---\n(.*?)\n---\n(.*)$", text, re.DOTALL)
    if not match:
        return "", text
    return match.group(1), match.group(2)


def parse_allowed_tools(frontmatter_yaml: str) -> list[str]:
    """Extract `allowed-tools:` (or `tools:`) field — pode ser inline list ou block."""
    # Tenta inline primeiro: `allowed-tools: Read, Write, Edit`
    inline = re.search(r"^allowed-tools:\s*(.+?)$", frontmatter_yaml, re.MULTILINE)
    if inline and not inline.group(1).strip().startswith("\n"):
        raw = inline.group(1).strip()
        if raw.startswith("[") and raw.endswith("]"):
            raw = raw[1:-1]
        return [t.strip() for t in raw.split(",") if t.strip()]

    # Bloco multi-line: `allowed-tools:\n  - Read\n  - Write`
    block_match = re.search(r"^allowed-tools:\s*\n((?:\s+-\s+\w+\n?)+)", frontmatter_yaml, re.MULTILINE)
    if block_match:
        return [
            line.strip("- ").strip()
            for line in block_match.group(1).splitlines()
            if line.strip().startswith("-")
        ]

    # Fallback: campo `tools:` (compat com config-skill style)
    tools_block = re.search(r"^tools:\s*\n((?:\s+-\s+\w+\n?)+)", frontmatter_yaml, re.MULTILINE)
    if tools_block:
        return [
            line.strip("- ").strip()
            for line in tools_block.group(1).splitlines()
            if line.strip().startswith("-")
        ]

    return []


def detect_tools_used(body: str) -> set[str]:
    """Scan body for tool usage signals."""
    used = set()
    for tool, patterns in TOOL_DETECTORS.items():
        for pattern in patterns:
            if re.search(pattern, body, re.IGNORECASE | re.MULTILINE):
                used.add(tool)
                break
    return used


def audit_skill(skill_md: Path) -> dict:
    """Audit single SKILL.md."""
    text = skill_md.read_text(encoding="utf-8")
    frontmatter, body = split_frontmatter_body(text)

    declared = set(parse_allowed_tools(frontmatter))
    used = detect_tools_used(body)

    declared_not_used = declared - used
    used_not_declared = used - declared

    return {
        "skill": skill_md.parent.name,
        "declared": sorted(declared),
        "used": sorted(used),
        "declared_not_used": sorted(declared_not_used),
        "used_not_declared": sorted(used_not_declared),  # ← issues de segurança
        "status": "FAIL" if used_not_declared else ("WARN" if declared_not_used else "OK"),
    }


def main() -> int:
    parser = argparse.ArgumentParser(description="Audit RBAC declarations across SKILL.md files.")
    parser.add_argument("--repo-root", default=None, help="Repo root (default: auto-detect)")
    parser.add_argument("--filter", default=None, help="Audit only skills matching this name substring")
    parser.add_argument("--strict", action="store_true", help="Treat WARN (declared but unused) as failure")
    args = parser.parse_args()

    if args.repo_root:
        repo_root = Path(args.repo_root).resolve()
    else:
        cur = Path.cwd()
        repo_root = cur
        while cur != cur.parent:
            if (cur / ".claude" / "skills").is_dir():
                repo_root = cur
                break
            cur = cur.parent

    skills_dir = repo_root / ".claude" / "skills"
    if not skills_dir.is_dir():
        print(json.dumps({"status": "ERROR", "error": f".claude/skills/ não encontrado em {repo_root}"}, indent=2, ensure_ascii=False))
        return 2

    audits = []
    for skill_folder in sorted(skills_dir.iterdir()):
        if not skill_folder.is_dir() or skill_folder.name.startswith("_"):
            continue
        if args.filter and args.filter not in skill_folder.name:
            continue
        skill_md = skill_folder / "SKILL.md"
        if not skill_md.exists():
            continue
        audits.append(audit_skill(skill_md))

    fails = [a for a in audits if a["status"] == "FAIL"]
    warns = [a for a in audits if a["status"] == "WARN"]

    overall_pass = len(fails) == 0 and (not args.strict or len(warns) == 0)

    result = {
        "status": "PASS" if overall_pass else "FAIL",
        "audited": len(audits),
        "fails": len(fails),
        "warns": len(warns),
        "audits": audits,
    }

    print(json.dumps(result, indent=2, ensure_ascii=False))
    return 0 if overall_pass else 1


if __name__ == "__main__":
    sys.exit(main())
